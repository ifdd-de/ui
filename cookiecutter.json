{
  "ifdd_ui_prj_name": "IFDD UI",
  "ifdd_ui_prj_slug": "{{ cookiecutter.ifdd_ui_prj_name|lower|replace(' ', '_') }}",
  "ifdd_ui_version": "26.10.2",
  "ifdd_ui_host": "ifdd_ui",
  "ifdd_ui_url": "http://ifdd_ui:80",
  "ifdd_ui_title": "IFDD",
  "ifdd_ui_enable_tls": "n",
  "ifdd_ui_enable_letsencrypt": "n",
  "ifdd_ui_aspects": "[\"product\", \"function\", \"location\", \"organisation\", \"project\"]",
  "ifdd_ui_show_explorer": "n",
  "ifdd_be_url": "http://data",
  "ifdd_schema_url": "http://schema:80",
  "ifdd_type_url": "http://type:80",
  "ifdd_unit_url": "http://unit:80",
  "ifdd_oidc_provider": "keycloak",
  "ifdd_oidc_realm": "https://id.domain/realms/testrealm",
  "ifdd_oidc_client_id": "client_id",
  "ifdd_registry_url": "ghcr.io/ifdd-de",
  "ifdd_proxy_network": "proxy-net",
  "_copy_without_render": [
    "src/*.jsx",
    "src/*.css",
    "src/ifdd_backend_provider.js",
    "src/ifdd_theme.js",
    "src/permissions.js",
    "src/tools_validity_color.js",
    "src/auth",
    "src/i18n",
    "src/ifdd",
    "src/private",
    "tests",
    "vite.config.js",
    ".github"
  ]
}
